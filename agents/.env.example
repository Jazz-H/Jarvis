# Copy to agents/.env for local runs (gitignored). In GitHub these are Actions secrets.
ANTHROPIC_API_KEY=
JARVIS_GIST_ID=
JARVIS_GIST_TOKEN=
# Optional
MAX_RUN_COST_USD=0.50
# Optional: the bank feed (docs/jarvis/SETUP.md → Bank feed). PLAID_ENV=sandbox to try fake banks first.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# JSON from npm run plaid-link, one entry per login: {"chase":"access-..."}
PLAID_ACCESS_TOKENS=
